{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "helix-toolbox-gui",
  "mainBinaryName": "helix-toolbox-gui",
  "identifier": "io.github.commanderx-code.helix-toolbox",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Helix Toolbox",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 640,
        "backgroundColor": "#0d111a"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb",
      "rpm",
      "appimage"
    ],
    "category": "Utility",
    "shortDescription": "Build, configure and optimize a Linux machine",
    "longDescription": "Helix Toolbox in a window: browse the catalog, queue entries in the Install Plan, review what each step does, and run it with an embedded terminal for prompts and passwords.",
    "icon": [
      "icons/16x16.png",
      "icons/24x24.png",
      "icons/32x32.png",
      "icons/48x48.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "depends": [
          "helix-toolbox"
        ],
        "section": "utils",
        "desktopTemplate": "../../../packaging/helix-toolbox-gui.desktop"
      },
      "rpm": {
        "depends": [
          "helix-toolbox"
        ],
        "desktopTemplate": "../../../packaging/helix-toolbox-gui.desktop"
      },
      "appimage": {
        "bundleMediaFramework": false
      }
    }
  }
}
